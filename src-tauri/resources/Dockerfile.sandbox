# The image Desk builds for Docker sandboxes: git, Node, ripgrep and the two
# agent CLIs that run headless. Agents run as an ordinary user, because Claude
# Code refuses to skip permission checks as root.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep procps ca-certificates curl openssh-client less tmux \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code @openai/codex \
 && npm cache clean --force

# Your extra lines (Settings ▸ Sandboxes ▸ Startup) go here, as root.
# DESK-EXTRA

RUN useradd --create-home --shell /bin/bash desk

USER desk
WORKDIR /home/desk
ENV HOME=/home/desk
CMD ["sleep", "infinity"]
